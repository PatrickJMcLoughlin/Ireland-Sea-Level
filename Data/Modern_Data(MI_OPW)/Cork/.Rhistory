results <- rbind(results, data.frame(year = year_to_analyze, month = m, z0_amplitude = z0_amp))
}
# Merge missing_days info for reporting
final_output <- results %>%
left_join(month_missing_summary %>% select(year, month, total_problem_days), by = c("year", "month")) %>%
mutate(missing_days = total_problem_days,
total_problem_days = NULL) %>%
select(year, month, missing_days, z0_amplitude) %>%
arrange(month)
final_output$month <- month.name[final_output$month]
return(final_output)
}
# Process all files
all_years_results <- data.frame(year = integer(),
month = character(),
missing_days = integer(),
z0_amplitude = numeric(),
stringsAsFactors = FALSE)
for (file in files) {
yr_result <- tryCatch(process_year_file(file), error = function(e) {
message("Error processing ", file, ": ", e)
return(NULL)
})
if (!is.null(yr_result)) {
all_years_results <- bind_rows(all_years_results, yr_result)
}
}
# Prepare final output
all_years <- seq(min(all_years_results$year), max(all_years_results$year))
full_year_month <- expand.grid(year = all_years, month = 1:12)
all_years_results_renamed <- all_years_results %>%
rename(monthly_avg = z0_amplitude) %>%
mutate(month = as.integer(factor(month, levels = month.name))) %>%
select(year, month, monthly_avg)
all_years_complete <- full_year_month %>%
left_join(all_years_results_renamed, by = c("year", "month")) %>%
arrange(year, month) %>%
mutate(monthly_avg = ifelse(is.na(monthly_avg), NA, monthly_avg))
# Optional: apply datum adjustment
all_years_complete <- all_years_complete %>%
mutate(monthly_avg = monthly_avg - 2.01 + 0.037) %>%
filter(year <= 2010)
# Write output
write_delim(all_years_complete, "monthly_avg_1901_2010.txt", delim = "\t", na = "NA")
message("Processing complete! Here's a preview:")
print(head(all_years_complete))
# --- Libraries ---
library(dplyr)
library(tidyr)
library(lubridate)
library(oce)
library(readr)
# --- Set working directory to Kilrush Head modern data ---
setwd("C:/Users/patri/Dropbox/RetroSharedFolder/Mean_Sea_Level_Ireland _Curve/rfiles/Final_Data/GITHUB/Data/Modern_Data(MI_OPW)/Galway")
# --- List all CSV files in folder (only years like 2003, 2004, etc.) ---
files <- list.files(pattern = "^[0-9]{4}.*\\.csv$")
# --- Function to process one year's file ---
process_year_file <- function(filename) {
message("Processing file: ", filename)
year_to_analyze <- as.integer(substr(filename, 1, 4))
# Read CSV safely
raw_data <- suppressMessages(read_csv(filename, na = c("NA","na","")))
# Automatically detect Date and Value columns
date_col <- grep("Date|Time|date|time", names(raw_data), value = TRUE)[1]
value_col <- grep("Reading|Value|reading|value|height", names(raw_data), value = TRUE)[1]
if (is.na(date_col) || is.na(value_col)) {
message("⚠️ Skipping ", filename, ": No valid Date or Value columns found.")
return(NULL)
}
raw_data <- raw_data %>%
select(Date = all_of(date_col), Value = all_of(value_col))
# Convert Date to POSIXct
raw_data$Date <- as.POSIXct(raw_data$Date, tz="UTC", format="%Y-%m-%dT%H:%M:%SZ")
yearly_data <- raw_data %>%
filter(year(Date) == year_to_analyze) %>%
mutate(year = year(Date), month = month(Date), day = day(Date))
if (nrow(yearly_data) == 0) {
message("⚠️ Skipping ", filename, ": No valid data for that year.")
return(NULL)
}
# Full calendar days
full_days <- tibble(
Date = seq.Date(as.Date(paste0(year_to_analyze,"-01-01")),
as.Date(paste0(year_to_analyze,"-12-31")),
by="day")
) %>%
mutate(year = year(Date), month = month(Date), day = day(Date))
# Calculate missing hours per day
missing_hours <- yearly_data %>%
group_by(year, month, day) %>%
summarize(missing_hours = sum(is.na(Value)), total_hours = n(), .groups="drop")
missing_hours_full <- full_days %>%
left_join(missing_hours, by=c("year","month","day")) %>%
mutate(
missing_hours = replace_na(missing_hours, 24),
total_hours = replace_na(total_hours, 24)
)
# Count missing days
full_missing_days <- missing_hours_full %>%
filter(missing_hours == 24) %>%
group_by(year, month) %>%
summarize(full_missing_count = n(), .groups="drop")
incomplete_days <- missing_hours_full %>%
filter(missing_hours > 4 & missing_hours < 24) %>%
group_by(year, month) %>%
summarize(incomplete_count = n(), .groups="drop")
month_missing_summary <- full_join(full_missing_days, incomplete_days, by=c("year","month")) %>%
mutate(
full_missing_count = replace_na(full_missing_count, 0),
incomplete_count = replace_na(incomplete_count, 0),
total_problem_days = full_missing_count + incomplete_count,
skip_month = total_problem_days >= 15
)
# --- Compute tidal amplitude ---
get_tidem_for_month <- function(y, m, data) {
subset_data <- data %>%
filter(year==y, month==m) %>%
mutate(Date=floor_date(Date,"hour"))
if(nrow(subset_data)==0) return(NULL)
subset_data <- subset_data %>%
complete(Date = seq.POSIXt(min(Date), max(Date), by="hour"), fill=list(Value=NA))
if(sum(!is.na(subset_data$Value)) < 10) return(NULL)
sl <- tryCatch(as.sealevel(subset_data$Value, subset_data$Date), error=function(e) NULL)
if(is.null(sl)) return(NULL)
tryCatch(tidem(sl), error=function(e) NULL)
}
results <- data.frame(year=integer(), month=integer(), z0_amplitude=numeric())
for(m in 1:12) {
skip <- month_missing_summary$skip_month[
month_missing_summary$year==year_to_analyze & month_missing_summary$month==m
]
if(length(skip)==0) skip <- FALSE
z0_amp <- if(skip) NA else {
tidem_res <- get_tidem_for_month(year_to_analyze, m, yearly_data)
if(!is.null(tidem_res)) tidem_res@data$amplitude[1] else NA
}
results <- rbind(results, data.frame(year=year_to_analyze, month=m, z0_amplitude=z0_amp))
}
final_output <- results %>%
left_join(month_missing_summary %>% select(year,month,total_problem_days), by=c("year","month")) %>%
mutate(missing_days = total_problem_days) %>%
select(year, month, missing_days, z0_amplitude) %>%
arrange(month)
final_output$month <- month.name[final_output$month]
return(final_output)
}
# --- Process all available files ---
all_years_results <- data.frame(year=integer(), month=character(), missing_days=integer(), z0_amplitude=numeric())
for(file in files){
res <- tryCatch(process_year_file(file), error=function(e){message(e); NULL})
if(!is.null(res)) all_years_results <- bind_rows(all_years_results, res)
}
# --- Prepare and save final dataset ---
if(nrow(all_years_results) > 0){
all_years <- sort(unique(all_years_results$year))
full_year_month <- expand.grid(year=all_years, month=1:12)
all_years_results_renamed <- all_years_results %>%
rename(monthly_avg = z0_amplitude) %>%
mutate(month = as.integer(factor(month, levels=month.name))) %>%
select(year, month, monthly_avg)
all_years_complete <- full_year_month %>%
left_join(all_years_results_renamed, by=c("year","month")) %>%
arrange(year, month)
write_delim(all_years_complete, "Galway_monthly_avg_2003_2024.txt", delim="\t", na="NA")
message("✅ Processing complete! Preview:")
print(head(all_years_complete))
} else {
message("⚠️ No valid data processed. Check your CSV files.")
}
# Load necessary libraries
library(lubridate)  # For date manipulation
library(ncdf4)      # For working with NetCDF files
library(tidyverse)  # For data manipulation and ggplot2
# Load the data and ensure monthly_avg is numeric
Belfast <- read_delim("Belfast_Harbour.txt", delim = "\t", col_names = TRUE,
col_types = cols(
year = col_double(),
month = col_double(),
monthly_avg = col_double()  # force numeric
)) %>%
mutate(
Water_Level_ODMalin = monthly_avg * 1000,  # convert to mm
date = make_date(year, month, 15)
) %>%
filter(year <= 2015)
# -----------------------------
# Helper function (Dun Laoghaire style)
# -----------------------------
average_near_location <- function(field, long, lat, target_lon, target_lat, time) {
long_index <- which(abs(long - target_lon) < 1)
lat_index  <- which(abs(lat - target_lat) < 1)
if (length(long_index) == 0 || length(lat_index) == 0) {
stop("No matching grid points found. Check coordinates or tolerance.")
}
values <- matrix(nrow = length(time), ncol = length(long_index) * length(lat_index))
col_num <- 1
for (lon_i in long_index) {
for (lat_i in lat_index) {
values[, col_num] <- field[lon_i, lat_i, ]
col_num <- col_num + 1
}
}
rowMeans(values, na.rm = TRUE)
}
# 2. Load the pre-calculated pressure anomaly data
load("ocean_surf_pressure_anomalyhis.Rdata")  # loads opresa, long, lat, time
pres = opresa
# Belfast Coordinates (0-360 system)
belfast_lat <- 54.7
belfast_lon <- 354.5
# Use averaging instead of single nearest neighbor
pres_avg <- average_near_location(pres, long, lat, belfast_lon, belfast_lat, time)
pres_belfast <- tibble(
pres_anomaly = pres_avg,
time = time,
month = month(time),
year = year(time)
)
# 3. Load wind data (u-wind and v-wind)
fn <- "uwnd.10m.mon.mean.nc"
nc <- nc_open(fn)
lat_u <- ncvar_get(nc, "lat")
long_u <- ncvar_get(nc, "lon")
time_u <- as.POSIXct(ncvar_get(nc, "time") * 3600, origin = "1800-01-01", tz = "UTC")
uwnd <- ncvar_get(nc, "uwnd")
nc_close(nc)
uwnd_avg <- average_near_location(uwnd, long_u, lat_u, belfast_lon, belfast_lat, time_u)
pres_belfast$uwnd <- uwnd_avg
# Define the drag coefficient function (based on wind speed)
calculate_CD <- function(wind_speed) {
ifelse(abs(wind_speed) >= 7.5,
0.00061 + 0.000063 * wind_speed,
0.001)
}
rho_a <- 1.225
pres_belfast$taux <- rho_a * calculate_CD(uwnd_avg) * abs(uwnd_avg) * uwnd_avg
# Load v-wind data
fn_vwnd <- "vwnd.10m.mon.mean.nc"
nc <- nc_open(fn_vwnd)
vwnd <- ncvar_get(nc, "vwnd")
nc_close(nc)
vwnd_avg <- average_near_location(vwnd, long_u, lat_u, belfast_lon, belfast_lat, time_u)
pres_belfast$vwnd <- vwnd_avg
pres_belfast$tauy <- rho_a * calculate_CD(vwnd_avg) * abs(vwnd_avg) * vwnd_avg
# Merge the Belfast data with the pressure and wind stress data
Belfast <- left_join(Belfast,
pres_belfast %>% select(year, month, pres_anomaly, taux, tauy),
by = c("year", "month"))
# Clean the data by removing rows with missing values
Belfast_clean <- Belfast %>% drop_na(Water_Level_ODMalin, pres_anomaly, taux, tauy)
# Add time column to the cleaned data
Belfast_clean <- Belfast_clean %>%
mutate(time = make_datetime(year, month, 1, tz = "UTC"))
)
# Fit a linear model
ib_model_belfast <- lm(Water_Level_ODMalin ~ pres_anomaly + taux + tauy +
sin(as.numeric(Belfast_clean$time) * 2 * pi / 365.25 / 86400) +
cos(as.numeric(Belfast_clean$time) * 2 * pi / 365.25 / 86400) +
sin(as.numeric(Belfast_clean$time) * 2 * pi / 182.63 / 86400),
data = Belfast_clean)
#ib_model_belfast <- lm(Water_Level_ODMalin ~ pres_anomaly + taux + tauy +
#sin(as.numeric(time) * 2 * pi / 365.25 / 86400) +
#cos(as.numeric(time) * 2 * pi / 365.25 / 86400) +
#sin(as.numeric(time) * 2 * pi / 182.63 / 86400) +
#cos(as.numeric(time) * 2 * pi / 182.63 / 86400),
#data = Belfast_clean)
# Check the model summary for Belfast
summary(ib_model_belfast)
# Extract model coefficients
model_coefficients_belfast <- ib_model_belfast$coefficients
print(model_coefficients_belfast)
# Remove the atmospheric pressure effect from the water level
Belfast_clean <- Belfast_clean %>%
mutate(Water_Level_no_atm = ib_model_belfast$residuals + model_coefficients_belfast[1])
# Plot adjusted water level
ggplot(Belfast_clean) +
geom_line(aes(x = time, y = Water_Level_ODMalin), color = 'grey', na.rm = TRUE) +
geom_line(aes(x = time, y = Water_Level_no_atm), color = 'red', na.rm = TRUE) +
geom_smooth(data = Belfast_clean %>% filter(year(time) < 2018),
aes(x = time, y = Water_Level_no_atm),
method = "lm") +
labs(title = "Water Level with and without Atmospheric Pressure Effect (Belfast)",
x = "Time", y = "Water Level (mm)") +
theme_minimal()
# ============================================================
# Section: Final Plot and High-Resolution Export (Belfast)
# ============================================================
#
# Description:
#   Creates a comparative plot of observed vs atmospheric-adjusted
#   Belfast monthly sea level data, including a fitted trend line.
#   Exports the figure as a 600 dpi PNG suitable for publication.
# ============================================================
library(ggplot2)
# Build the plot
belfast_plot <- ggplot(Belfast_clean, aes(x = time)) +
geom_line(aes(y = Water_Level_ODMalin, color = "Observed"), linewidth = 0.8, na.rm = TRUE) +
geom_line(aes(y = Water_Level_no_atm, color = "Atmospheric-Adjusted"), linewidth = 0.8, na.rm = TRUE) +
geom_smooth(
data = Belfast_clean %>% filter(year(time) < 2018),
aes(y = Water_Level_no_atm, color = "Trend (Adjusted)"),
method = "lm", se = FALSE, linewidth = 1
) +
labs(
title = "Belfast Monthly Sea Level: Observed vs Atmospheric-Adjusted (pressure and wind stress effects)",
subtitle = " ",
x = "Year",
y = "Water Level (mm)",
color = "Series"
) +
theme_minimal(base_size = 12) +
theme(
legend.position = "right",
legend.title = element_text(size = 11),
legend.text = element_text(size = 10),
plot.title = element_text(face = "bold", size = 14, hjust = 0.5),
plot.subtitle = element_text(size = 11, hjust = 0.5)
) +
scale_color_manual(
values = c(
"Observed" = "grey40",
"Atmospheric-Adjusted" = "red",
"Trend (Adjusted)" = "blue"
)
)
# Display plot in RStudio / console
print(belfast_plot)
# Save high-resolution version (600 dpi, 8x5 inches)
ggsave(
filename = "Belfast_Water_Level_Atmospheric_Adjustment.png",
plot = belfast_plot,
width = 8, height = 5, dpi = 600
)
# Check residuals
ggplot(Belfast_clean) +
geom_point(aes(x = Water_Level_no_atm, y = pres_anomaly)) +
labs(title = "Water Level vs Pressure at Belfast",
x = "Water Level (mm)", y = "Pressure Anomaly (Pa)") +
theme_minimal()
# Convert water levels to meters
Belfast_clean <- Belfast_clean %>%
mutate(Water_Level_ODMalin = Water_Level_ODMalin / 1000,
Water_Level_no_atm = Water_Level_no_atm / 1000)
# Calculate stats
sd(Belfast_clean$Water_Level_ODMalin, na.rm = TRUE)
sd(Belfast_clean$Water_Level_no_atm, na.rm = TRUE)
mean(Belfast_clean$Water_Level_ODMalin, na.rm = TRUE)
mean(Belfast_clean$Water_Level_no_atm, na.rm = TRUE)
# Final plot
ggplot(Belfast_clean) +
geom_line(aes(x = time, y = Water_Level_no_atm), color = 'blue', na.rm = TRUE) +
labs(title = "Water Level Without Atmospheric Pressure Effect (Monthly Adjustment)",
x = "Time", y = "Adjusted Water Level (mm)") +
theme_minimal()
# Yearly means with at least 3 consecutive valid months
yearly_means_belfast <- Belfast_clean %>%
mutate(year = year(time), month = month(time)) %>%
group_by(year) %>%
arrange(month) %>%
summarise(
valid_months_vec = list(month[!is.na(Water_Level_no_atm)]),
has_3_consecutive = any(sapply(seq_along(valid_months_vec[[1]]), function(i) {
if (i + 2 <= length(valid_months_vec[[1]])) {
all(diff(valid_months_vec[[1]][i:(i+2)]) == 1)
} else {
FALSE
}
})),
mean_Water_Level_ODMalin = ifelse(has_3_consecutive,
mean(Water_Level_ODMalin[!is.na(Water_Level_no_atm)], na.rm = TRUE),
NA_real_),
mean_Water_Level_no_atm = ifelse(has_3_consecutive,
mean(Water_Level_no_atm[!is.na(Water_Level_no_atm)], na.rm = TRUE),
NA_real_)
) %>%
filter(!is.na(mean_Water_Level_no_atm)) %>%
select(-valid_months_vec, -has_3_consecutive)
# Monthly means after IB removal
monthly_means <- Belfast_clean %>%
mutate(year = year(time), month = month(time)) %>%
group_by(year, month) %>%
summarise(
mean_Water_Level_ODMalin = mean(Water_Level_ODMalin, na.rm = TRUE),
mean_Water_Level_no_atm = mean(Water_Level_no_atm, na.rm = TRUE),
.groups = "drop"
) %>%
arrange(year, month)
# Save to CSV
write_csv(monthly_means, "Belfast_monthly_after_atm_removal.csv")
write_csv(yearly_means_belfast, "Belfast_Yearly_MSL.csv")
setwd("C:/Users/patri/Dropbox/RetroSharedFolder/Mean_Sea_Level_Ireland _Curve/rfiles/Final_Data/GITHUB/Data/Modern_Data(MI_OPW)/Cork")
# --- Libraries ---
library(dplyr)
library(tidyr)
library(lubridate)
library(oce)
library(readr)
# --- List all CSV files in folder (only years like 2003, 2004, etc.) ---
files <- list.files(pattern = "^[0-9]{4}.*\\.csv$")
# --- Function to process one year's file ---
process_year_file <- function(filename) {
message("Processing file: ", filename)
year_to_analyze <- as.integer(substr(filename, 1, 4))
# Read CSV safely
raw_data <- suppressMessages(read_csv(filename, na = c("NA","na","")))
# Automatically detect Date and Value columns
date_col <- grep("Date|Time|date|time", names(raw_data), value = TRUE)[1]
value_col <- grep("Reading|Value|reading|value|height", names(raw_data), value = TRUE)[1]
if (is.na(date_col) || is.na(value_col)) {
message("⚠️ Skipping ", filename, ": No valid Date or Value columns found.")
return(NULL)
}
raw_data <- raw_data %>%
select(Date = all_of(date_col), Value = all_of(value_col))
# Convert Date to POSIXct
raw_data$Date <- as.POSIXct(raw_data$Date, tz="UTC", format="%Y-%m-%dT%H:%M:%SZ")
yearly_data <- raw_data %>%
filter(year(Date) == year_to_analyze) %>%
mutate(year = year(Date), month = month(Date), day = day(Date))
if (nrow(yearly_data) == 0) {
message("⚠️ Skipping ", filename, ": No valid data for that year.")
return(NULL)
}
# Full calendar days
full_days <- tibble(
Date = seq.Date(as.Date(paste0(year_to_analyze,"-01-01")),
as.Date(paste0(year_to_analyze,"-12-31")),
by="day")
) %>%
mutate(year = year(Date), month = month(Date), day = day(Date))
# Calculate missing hours per day
missing_hours <- yearly_data %>%
group_by(year, month, day) %>%
summarize(missing_hours = sum(is.na(Value)), total_hours = n(), .groups="drop")
missing_hours_full <- full_days %>%
left_join(missing_hours, by=c("year","month","day")) %>%
mutate(
missing_hours = replace_na(missing_hours, 24),
total_hours = replace_na(total_hours, 24)
)
# Count missing days
full_missing_days <- missing_hours_full %>%
filter(missing_hours == 24) %>%
group_by(year, month) %>%
summarize(full_missing_count = n(), .groups="drop")
incomplete_days <- missing_hours_full %>%
filter(missing_hours > 4 & missing_hours < 24) %>%
group_by(year, month) %>%
summarize(incomplete_count = n(), .groups="drop")
month_missing_summary <- full_join(full_missing_days, incomplete_days, by=c("year","month")) %>%
mutate(
full_missing_count = replace_na(full_missing_count, 0),
incomplete_count = replace_na(incomplete_count, 0),
total_problem_days = full_missing_count + incomplete_count,
skip_month = total_problem_days >= 15
)
# --- Compute tidal amplitude ---
get_tidem_for_month <- function(y, m, data) {
subset_data <- data %>%
filter(year==y, month==m) %>%
mutate(Date=floor_date(Date,"hour"))
if(nrow(subset_data)==0) return(NULL)
subset_data <- subset_data %>%
complete(Date = seq.POSIXt(min(Date), max(Date), by="hour"), fill=list(Value=NA))
if(sum(!is.na(subset_data$Value)) < 10) return(NULL)
sl <- tryCatch(as.sealevel(subset_data$Value, subset_data$Date), error=function(e) NULL)
if(is.null(sl)) return(NULL)
tryCatch(tidem(sl), error=function(e) NULL)
}
results <- data.frame(year=integer(), month=integer(), z0_amplitude=numeric())
for(m in 1:12) {
skip <- month_missing_summary$skip_month[
month_missing_summary$year==year_to_analyze & month_missing_summary$month==m
]
if(length(skip)==0) skip <- FALSE
z0_amp <- if(skip) NA else {
tidem_res <- get_tidem_for_month(year_to_analyze, m, yearly_data)
if(!is.null(tidem_res)) tidem_res@data$amplitude[1] else NA
}
results <- rbind(results, data.frame(year=year_to_analyze, month=m, z0_amplitude=z0_amp))
}
final_output <- results %>%
left_join(month_missing_summary %>% select(year,month,total_problem_days), by=c("year","month")) %>%
mutate(missing_days = total_problem_days) %>%
select(year, month, missing_days, z0_amplitude) %>%
arrange(month)
final_output$month <- month.name[final_output$month]
return(final_output)
}
# --- Process all available files ---
all_years_results <- data.frame(year=integer(), month=character(), missing_days=integer(), z0_amplitude=numeric())
for(file in files){
res <- tryCatch(process_year_file(file), error=function(e){message(e); NULL})
if(!is.null(res)) all_years_results <- bind_rows(all_years_results, res)
}
# --- Prepare and save final dataset ---
if(nrow(all_years_results) > 0){
all_years <- sort(unique(all_years_results$year))
full_year_month <- expand.grid(year=all_years, month=1:12)
all_years_results_renamed <- all_years_results %>%
rename(monthly_avg = z0_amplitude) %>%
mutate(month = as.integer(factor(month, levels=month.name))) %>%
select(year, month, monthly_avg)
all_years_complete <- full_year_month %>%
left_join(all_years_results_renamed, by=c("year","month")) %>%
arrange(year, month)
write_delim(all_years_complete, "Malin_Head_monthly_avg_2003_2024.txt", delim="\t", na="NA")
message("✅ Processing complete! Preview:")
print(head(all_years_complete))
} else {
message("⚠️ No valid data processed. Check your CSV files.")
}

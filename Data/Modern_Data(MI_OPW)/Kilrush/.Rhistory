# --- Compute tidal amplitude (z₀) for valid months ---
get_tidem_for_month <- function(y, m, data) {
subset_data <- data %>%
filter(year == y, month == m) %>%
mutate(Date = floor_date(Date, "hour"))
if (nrow(subset_data) == 0) return(NULL)
subset_data <- subset_data %>%
complete(Date = seq.POSIXt(min(Date), max(Date), by = "hour"), fill = list(Value = NA))
if (sum(!is.na(subset_data$Value)) < 10) return(NULL)
sl <- tryCatch(as.sealevel(subset_data$Value, subset_data$Date), error = function(e) NULL)
if (is.null(sl)) return(NULL)
tryCatch(tidem(sl), error = function(e) NULL)
}
results <- data.frame(year = integer(), month = integer(), z0_amplitude = numeric())
for (m in 1:12) {
skip <- month_missing_summary$skip_month[
month_missing_summary$year == year_to_analyze &
month_missing_summary$month == m
]
if (length(skip) == 0) skip <- FALSE
z0_amp <- if (skip) NA else {
tidem_res <- get_tidem_for_month(year_to_analyze, m, yearly_data)
if (!is.null(tidem_res)) tidem_res@data$amplitude[1] else NA
}
results <- rbind(results, data.frame(year = year_to_analyze, month = m, z0_amplitude = z0_amp))
}
final_output <- results %>%
left_join(month_missing_summary %>% select(year, month, total_problem_days),
by = c("year", "month")) %>%
mutate(missing_days = total_problem_days) %>%
select(year, month, missing_days, z0_amplitude) %>%
arrange(month)
final_output$month <- month.name[final_output$month]
return(final_output)

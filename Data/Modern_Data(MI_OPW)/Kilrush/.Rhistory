# --- Libraries ---
library(dplyr)
library(tidyr)
library(lubridate)
library(oce)
library(readr)
# --- Set working directory to Tarbert data ---
setwd("C:/Users/patri/Dropbox/RetroSharedFolder/Mean_Sea_Level_Ireland _Curve/Tarbert")
# --- List all year files (e.g. 1974_TT.csv, 1975_TT.csv, etc.) ---
files <- list.files(pattern = "^[0-9]{4}.*_TT\\.csv$")
# --- Function to process one year's file ---
process_year_file <- function(filename) {
message("Processing file: ", filename)
# Extract year from filename (first 4 digits)
year_to_analyze <- as.integer(substr(filename, 1, 4))
# Read CSV safely
raw_data <- suppressMessages(read_csv(filename, na = c("NA", "na", "")))
# Automatically detect Date/Time and Reading columns
date_col <- grep("Date|Time|date|time", names(raw_data), value = TRUE)[1]
value_col <- grep("Reading|Value|reading|value|height", names(raw_data), value = TRUE)[1]
if (is.na(date_col) || is.na(value_col)) {
message("⚠️ Skipping ", filename, ": missing Date or Value columns.")
return(NULL)
}
raw_data <- raw_data %>%
select(Date = all_of(date_col), Value = all_of(value_col))
# Parse timestamp
raw_data$Date <- as.POSIXct(raw_data$Date, tz = "UTC", format = "%Y-%m-%dT%H:%M:%SZ")
# Keep only the relevant year
yearly_data <- raw_data %>%
filter(year(Date) == year_to_analyze) %>%
mutate(year = year(Date), month = month(Date), day = day(Date))
if (nrow(yearly_data) == 0) {
message("⚠️ Skipping ", filename, ": no valid data for this year.")
return(NULL)
}
# Create full calendar for that year
full_days <- tibble(
Date = seq.Date(as.Date(paste0(year_to_analyze, "-01-01")),
as.Date(paste0(year_to_analyze, "-12-31")),
by = "day")
) %>%
mutate(year = year(Date), month = month(Date), day = day(Date))
# --- Calculate missing hours per day ---
missing_hours <- yearly_data %>%
group_by(year, month, day) %>%
summarize(missing_hours = sum(is.na(Value)), total_hours = n(), .groups = "drop")
missing_hours_full <- full_days %>%
left_join(missing_hours, by = c("year", "month", "day")) %>%
mutate(
missing_hours = replace_na(missing_hours, 24),
total_hours = replace_na(total_hours, 24)
)
# --- Count missing days per month ---
full_missing_days <- missing_hours_full %>%
filter(missing_hours == 24) %>%
group_by(year, month) %>%
summarize(full_missing_count = n(), .groups = "drop")
incomplete_days <- missing_hours_full %>%
filter(missing_hours > 4 & missing_hours < 24) %>%
group_by(year, month) %>%
summarize(incomplete_count = n(), .groups = "drop")
month_missing_summary <- full_join(full_missing_days, incomplete_days, by = c("year", "month")) %>%
mutate(
full_missing_count = replace_na(full_missing_count, 0),
incomplete_count = replace_na(incomplete_count, 0),
total_problem_days = full_missing_count + incomplete_count,
skip_month = total_problem_days >= 15
)
# --- Compute tidal amplitude (z₀) for valid months ---
get_tidem_for_month <- function(y, m, data) {
subset_data <- data %>%
filter(year == y, month == m) %>%
mutate(Date = floor_date(Date, "hour"))
if (nrow(subset_data) == 0) return(NULL)
subset_data <- subset_data %>%
complete(Date = seq.POSIXt(min(Date), max(Date), by = "hour"), fill = list(Value = NA))
if (sum(!is.na(subset_data$Value)) < 10) return(NULL)
sl <- tryCatch(as.sealevel(subset_data$Value, subset_data$Date), error = function(e) NULL)
if (is.null(sl)) return(NULL)
tryCatch(tidem(sl), error = function(e) NULL)
}
results <- data.frame(year = integer(), month = integer(), z0_amplitude = numeric())
for (m in 1:12) {
skip <- month_missing_summary$skip_month[
month_missing_summary$year == year_to_analyze &
month_missing_summary$month == m
]
if (length(skip) == 0) skip <- FALSE
z0_amp <- if (skip) NA else {
tidem_res <- get_tidem_for_month(year_to_analyze, m, yearly_data)
if (!is.null(tidem_res)) tidem_res@data$amplitude[1] else NA
}
results <- rbind(results, data.frame(year = year_to_analyze, month = m, z0_amplitude = z0_amp))
}
final_output <- results %>%
left_join(month_missing_summary %>% select(year, month, total_problem_days),
by = c("year", "month")) %>%
mutate(missing_days = total_problem_days) %>%
select(year, month, missing_days, z0_amplitude) %>%
arrange(month)
final_output$month <- month.name[final_output$month]
return(final_output)
}
# --- Run across all Tarbert files ---
all_years_results <- data.frame(year = integer(), month = character(),
missing_days = integer(), z0_amplitude = numeric())
for (file in files) {
res <- tryCatch(process_year_file(file), error = function(e) { message(e); NULL })
if (!is.null(res)) all_years_results <- bind_rows(all_years_results, res)
}
# --- Final combined dataset ---
if (nrow(all_years_results) > 0) {
all_years <- sort(unique(all_years_results$year))
full_year_month <- expand.grid(year = all_years, month = 1:12)
all_years_results_renamed <- all_years_results %>%
rename(monthly_avg = z0_amplitude) %>%
mutate(month = as.integer(factor(month, levels = month.name))) %>%
select(year, month, monthly_avg)
all_years_complete <- full_year_month %>%
left_join(all_years_results_renamed, by = c("year", "month")) %>%
arrange(year, month)
write_delim(all_years_complete, "Tarbert_monthly_avg.txt", delim = "\t", na = "NA")
message("✅ Processing complete! Preview:")
print(head(all_years_complete))
} else {
message("⚠️ No valid Tarbert data processed. Check your CSV files.")
}

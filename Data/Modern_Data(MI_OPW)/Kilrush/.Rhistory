print(head(all_years_complete))
library(dplyr)
library(tidyr)
library(lubridate)
library(oce)
library(readr)
# Set working directory
setwd("C:/Users/patri/Dropbox/RetroSharedFolder/Mean_Sea_Level_Ireland _Curve/Belfast data (Hourly)")
# List all CSV files in the folder
files <- list.files(pattern = "\\d{4}.*\\.csv$")
process_year_file <- function(filename) {
message("Processing file: ", filename)
year_to_analyze <- as.integer(substr(filename, 1, 4))
# Read CSV, drop fully empty columns
raw_data <- read_csv(filename, col_types = cols(.default = col_guess()))
raw_data <- raw_data[, colSums(!is.na(raw_data)) > 0]
# Rename first 3 columns
colnames(raw_data)[1:3] <- c("Date", "Value", "Quality_Code")
# Ensure Date is POSIXct
raw_data$Date <- as.POSIXct(raw_data$Date, tz = "UTC")
yearly_data <- raw_data %>%
filter(year(Date) == year_to_analyze) %>%
mutate(year = year(Date), month = month(Date), day = day(Date))
# Create full calendar days
full_days <- tibble(
Date = seq.Date(as.Date(paste0(year_to_analyze, "-01-01")),
as.Date(paste0(year_to_analyze, "-12-31")),
by = "day")
) %>%
mutate(year = year(Date), month = month(Date), day = day(Date))
# Calculate missing hours per day
missing_hours <- yearly_data %>%
group_by(year, month, day) %>%
summarize(missing_hours = sum(is.na(Value)), total_hours = n(), .groups = "drop")
missing_hours_full <- full_days %>%
left_join(missing_hours, by = c("year", "month", "day")) %>%
mutate(
missing_hours = replace_na(missing_hours, 24),
total_hours = replace_na(total_hours, 24)
)
# Count fully missing and incomplete days (>4h missing)
full_missing_days <- missing_hours_full %>%
filter(missing_hours == 24) %>%
group_by(year, month) %>%
summarize(full_missing_count = n(), .groups = "drop")
incomplete_days <- missing_hours_full %>%
filter(missing_hours > 4 & missing_hours < 24) %>%
group_by(year, month) %>%
summarize(incomplete_count = n(), .groups = "drop")
# Determine months to skip
month_missing_summary <- full_join(full_missing_days, incomplete_days, by = c("year", "month")) %>%
mutate(
full_missing_count = replace_na(full_missing_count, 0),
incomplete_count = replace_na(incomplete_count, 0),
total_problem_days = full_missing_count + incomplete_count,
skip_month = total_problem_days >= 15
)
# Function to get tidem for a month
get_tidem_for_month <- function(year_num, month_num, data) {
subset_data <- data %>%
filter(year == year_num, month == month_num) %>%
mutate(Date = floor_date(Date, unit = "hour"))
if (nrow(subset_data) == 0) return(NULL)
subset_data <- subset_data %>%
complete(Date = seq.POSIXt(min(Date), max(Date), by = "hour"), fill = list(Value = NA))
if (sum(!is.na(subset_data$Value)) < 10) return(NULL)
sl <- tryCatch(as.sealevel(subset_data$Value, subset_data$Date), error = function(e) NULL)
if (is.null(sl)) return(NULL)
tidem_res <- tryCatch(tidem(sl), error = function(e) NULL)
tidem_res
}
results <- data.frame(year = integer(), month = integer(), z0_amplitude = numeric())
for (m in 1:12) {
skip <- month_missing_summary$skip_month[
month_missing_summary$year == year_to_analyze &
month_missing_summary$month == m
]
if (length(skip) == 0) skip <- FALSE
if (skip) {
z0_amp <- NA
} else {
oce_calc <- get_tidem_for_month(year_to_analyze, m, yearly_data)
z0_amp <- if (!is.null(oce_calc)) oce_calc@data$amplitude[1] else NA
}
results <- rbind(results, data.frame(year = year_to_analyze, month = m, z0_amplitude = z0_amp))
}
# Merge missing_days info for reporting
final_output <- results %>%
left_join(month_missing_summary %>% select(year, month, total_problem_days), by = c("year", "month")) %>%
mutate(missing_days = total_problem_days,
total_problem_days = NULL) %>%
select(year, month, missing_days, z0_amplitude) %>%
arrange(month)
final_output$month <- month.name[final_output$month]
return(final_output)
}
# Process all files
all_years_results <- data.frame(year = integer(),
month = character(),
missing_days = integer(),
z0_amplitude = numeric(),
stringsAsFactors = FALSE)
for (file in files) {
yr_result <- tryCatch(process_year_file(file), error = function(e) {
message("Error processing ", file, ": ", e)
return(NULL)
})
if (!is.null(yr_result)) {
all_years_results <- bind_rows(all_years_results, yr_result)
}
}
# Prepare final output
all_years <- seq(min(all_years_results$year), max(all_years_results$year))
full_year_month <- expand.grid(year = all_years, month = 1:12)
all_years_results_renamed <- all_years_results %>%
rename(monthly_avg = z0_amplitude) %>%
mutate(month = as.integer(factor(month, levels = month.name))) %>%
select(year, month, monthly_avg)
all_years_complete <- full_year_month %>%
left_join(all_years_results_renamed, by = c("year", "month")) %>%
arrange(year, month) %>%
mutate(monthly_avg = ifelse(is.na(monthly_avg), NA, monthly_avg))
# Optional: apply datum adjustment
all_years_complete <- all_years_complete %>%
mutate(monthly_avg = monthly_avg - 2.01 + 0.037) %>%
filter(year <= 2010)
# Write output
write_delim(all_years_complete, "monthly_avg_1901_2010.txt", delim = "\t", na = "NA")
message("Processing complete! Here's a preview:")
print(head(all_years_complete))
